COMPOSE_PROJECT_NAME=xiaobai-one
XIAOBAI_WEB_BIND=127.0.0.1
XIAOBAI_WEB_PORT=3210
XIAOBAI_API_PORT=3211
XIAOBAI_DATA_ROOT=./data
XIAOBAI_HOST_DATA_DIR=
XIAOBAI_SECRET_KEY=change-this-secret-before-production
XIAOBAI_BOOTSTRAP_ADMIN_USERNAME=admin
XIAOBAI_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
XIAOBAI_BOOTSTRAP_ADMIN_DISPLAY_NAME=引导管理员
XIAOBAI_ENGINE_MODE=mock
XIAOBAI_AINOVEL_IMAGE=ghcr.io/voocel/ainovel-cli:latest
XIAOBAI_AINOVEL_NETWORK=
XIAOBAI_AINOVEL_MEMORY=768m
XIAOBAI_AINOVEL_CPUS=1.0
XIAOBAI_AINOVEL_PIDS_LIMIT=256
XIAOBAI_ACTIVE_RUNS_PER_OPERATOR=1
XIAOBAI_ACTIVE_RUNS_GLOBAL=2
